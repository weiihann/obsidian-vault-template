filters:
  and:
    - categories.contains(link("Knowledge"))
    - '!file.name.contains("Template")'
properties:
  file.name:
    displayName: Name
  note.rating:
    displayName: Rating
  note.created:
    displayName: Created
  note.tags:
    displayName: Tags
views:
  - type: table
    name: All
    order:
      - file.name
      - rating
      - created
      - tags
    sort:
      - property: file.name
        direction: ASC
